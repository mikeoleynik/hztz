{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hz/audit/questions",
  "type": "object",
  "required": ["blocked", "questions"],
  "additionalProperties": false,
  "properties": {
    "blocked": { "$ref": "../../common/schema.json#/$defs/blocked" },
    "questions": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "../../common/schema.json#/$defs/question" },
          {
            "properties": {
              "findings": { "items": { "type": "string", "pattern": "^A[0-9]+$" } }
            }
          }
        ]
      }
    }
  }
}
