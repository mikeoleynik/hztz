{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hz/decompose",
  "type": "object",
  "required": ["blocked", "blocks", "tasks", "uncertainties", "uncovered", "skipped"],
  "additionalProperties": false,
  "properties": {
    "blocked": { "$ref": "../common/schema.json#/$defs/blocked" },

    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "matches", "kind", "title", "purpose", "requirements", "decisions", "contract", "files"],
        "additionalProperties": false,
        "properties": {
          "key": { "$ref": "../common/schema.json#/$defs/key" },
          "matches": { "type": ["string", "null"], "pattern": "^B[0-9]+$" },
          "kind": { "enum": ["data", "service", "job", "api", "ui", "integration", "infra"] },
          "title": { "type": "string", "maxLength": 100 },
          "purpose": { "type": "string" },
          "requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^R[0-9]+$" } },
          "decisions": { "type": "array", "items": { "type": "string", "pattern": "^D[0-9]+$" } },
          "contract": { "type": "string" },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "action"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "action": { "enum": ["create", "modify"] }
              }
            }
          }
        }
      }
    },

    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "matches", "block", "order", "title", "goal", "requirements", "depends_on", "blocked_by", "done_when", "notes"],
        "additionalProperties": false,
        "properties": {
          "key": { "$ref": "../common/schema.json#/$defs/key" },
          "matches": { "type": ["string", "null"], "pattern": "^T[0-9]+$" },
          "block": { "$ref": "../common/schema.json#/$defs/key_or_id" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "maxLength": 100 },
          "goal": { "type": "string" },
          "requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^R[0-9]+$" } },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^(T[0-9]+|[a-z][a-z0-9_]*)$" } },
          "blocked_by": { "type": "array", "items": { "type": "string", "pattern": "^([AO][0-9]+|[a-z][a-z0-9_]*)$" } },
          "done_when": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "question", "affects", "blocking"],
        "additionalProperties": false,
        "properties": {
          "finding": { "$ref": "../common/schema.json#/$defs/finding" },
          "question": { "$ref": "../common/schema.json#/$defs/question" },
          "affects": { "type": "array", "minItems": 1, "items": { "$ref": "../common/schema.json#/$defs/key_or_id" } },
          "blocking": { "type": "boolean" }
        }
      }
    },

    "uncovered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "reason", "detail"],
        "additionalProperties": false,
        "properties": {
          "requirement": { "type": "string", "pattern": "^R[0-9]+$" },
          "reason": { "enum": ["no_behaviour", "blocked", "needs_decision"] },
          "detail": { "type": "string" }
        }
      }
    },

    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "out_of_scope"],
        "additionalProperties": false,
        "properties": {
          "requirement": { "type": "string", "pattern": "^R[0-9]+$" },
          "out_of_scope": { "type": "string" }
        }
      }
    }
  }
}
